// Prisma Schema for Smart Local Service Backend (SQLite & PostgreSQL Compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  phone            String?
  role             String            @default("CUSTOMER") // CUSTOMER, PROVIDER, ADMIN
  avatarUrl        String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customerProfile  CustomerProfile?
  providerProfile  ProviderProfile?
  appliances       Appliance[]
  serviceRequests  ServiceRequest[]
  emergencyRequests EmergencyRequest[]
  bookings         Booking[]         @relation("CustomerBookings")
  reviewsGiven     Review[]          @relation("CustomerReviews")
  notifications    Notification[]
  mediaFiles       MediaFile[]
  aiAnalyses       AIAnalysis[]
  statusChanges    BookingStatusHistory[]

  @@map("users")
}

model CustomerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAddress String?
  latitude       Float    @default(12.9716) // Bangalore / City center default
  longitude      Float    @default(77.5946)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("customer_profiles")
}

model ProviderProfile {
  id                  String             @id @default(uuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String
  bio                 String?
  experienceYears     Int                @default(1)
  verificationStatus  String             @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  verificationDocUrl  String?
  basePrice           Float              @default(300)
  rating              Float              @default(5.0)
  reviewCount         Int                @default(0)
  jobsCompleted       Int                @default(0)
  responseTimeMinutes Int                @default(15)
  serviceRadiusKm     Float              @default(15.0)
  latitude            Float              @default(12.9716)
  longitude           Float              @default(77.5946)
  availableNow        Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  providerServices      ProviderService[]
  skills                ProviderSkill[]
  availabilities        ProviderAvailability[]
  locations             ProviderLocation[]
  bookings              Booking[]              @relation("ProviderBookings")
  reviewsReceived       Review[]               @relation("ProviderReviews")
  maintenanceRecords    MaintenanceRecord[]
  scores                ProviderScore[]
  recommendations       ProviderRecommendation[]

  @@map("provider_profiles")
}

model ServiceCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String   @default("wrench")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerServices ProviderService[]
  serviceRequests  ServiceRequest[]

  @@map("service_categories")
}

model ProviderService {
  id                String          @id @default(uuid())
  providerId        String
  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceCategoryId String
  serviceCategory   ServiceCategory @relation(fields: [serviceCategoryId], references: [id], onDelete: Cascade)
  estimatedPriceMin Float
  estimatedPriceMax Float
  createdAt         DateTime        @default(now())

  @@unique([providerId, serviceCategoryId])
  @@map("provider_services")
}

model ProviderSkill {
  id             String          @id @default(uuid())
  providerId     String
  provider       ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  skillName      String
  expertiseLevel String          @default("Expert") // Expert, Advanced, Intermediate
  applianceType  String?         // e.g. "AC", "Washing Machine", "Refrigerator", "Motorcycle"
  createdAt      DateTime        @default(now())

  @@map("provider_skills")
}

model ProviderAvailability {
  id          String          @id @default(uuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek   Int             // 0 = Sunday, 1 = Monday, etc.
  startTime   String          // "08:00"
  endTime     String          // "20:00"
  isAvailable Boolean         @default(true)

  @@map("provider_availability")
}

model ProviderLocation {
  id          String          @id @default(uuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  addressName String?
  latitude    Float
  longitude   Float
  isPrimary   Boolean         @default(true)

  @@map("provider_locations")
}

model Appliance {
  id                       String   @id @default(uuid())
  customerId               String
  customer                 User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name                     String   // e.g. "Living Room AC"
  brand                    String   // e.g. "LG"
  model                    String?  // e.g. "Dual Inverter 1.5T"
  purchaseDate             String?  // YYYY-MM-DD
  installationDate         String?  // YYYY-MM-DD
  lastServiceDate          String?  // YYYY-MM-DD
  maintenanceIntervalMonths Int     @default(6)
  warrantyInfo             String?  // e.g. "Under Warranty till 2027"
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  maintenanceRecords   MaintenanceRecord[]
  maintenanceReminders MaintenanceReminder[]

  @@map("appliances")
}

model MaintenanceRecord {
  id          String           @id @default(uuid())
  applianceId String
  appliance   Appliance        @relation(fields: [applianceId], references: [id], onDelete: Cascade)
  providerId  String?
  provider    ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  serviceDate String           // YYYY-MM-DD
  description String
  cost        Float            @default(0)
  notes       String?
  createdAt   DateTime         @default(now())

  @@map("maintenance_records")
}

model MaintenanceReminder {
  id          String   @id @default(uuid())
  applianceId String
  appliance   Appliance @relation(fields: [applianceId], references: [id], onDelete: Cascade)
  dueDate     String   // YYYY-MM-DD
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, ACKNOWLEDGED, COMPLETED, DISMISSED
  createdAt   DateTime @default(now())

  @@map("maintenance_reminders")
}

model MediaFile {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileType  String   // "image" or "video"
  mimeType  String   // e.g. "image/jpeg", "video/mp4"
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  aiAnalyses AIAnalysis[]

  @@map("media_files")
}

model AIAnalysis {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaFileId          String?
  mediaFile            MediaFile?  @relation(fields: [mediaFileId], references: [id], onDelete: SetNull)
  mediaType            String      @default("photo") // "photo", "video", "text"
  applianceType        String?     // e.g. "Washing Machine"
  vehicleType          String?     // MOTORCYCLE, SCOOTER, CAR, OTHER
  detectedProblem      String
  problemCategory      String
  severity             String      @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  confidence           Float       @default(0.85) // 0.0 to 1.0
  recommendedService   String
  estimatedCostMin     Float       @default(500)
  estimatedCostMax     Float       @default(1200)
  professionalRequired String
  suggestedNextSteps   String?
  createdAt            DateTime    @default(now())

  serviceRequests   ServiceRequest[]
  emergencyRequests EmergencyRequest[]

  @@map("ai_analysis")
}

model ServiceRequest {
  id                 String           @id @default(uuid())
  customerId         String
  customer           User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceCategoryId  String?
  serviceCategory    ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: SetNull)
  problemDescription String
  latitude           Float
  longitude          Float
  mediaUrl           String?
  aiAnalysisId       String?
  aiAnalysis         AIAnalysis?      @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)
  status             String           @default("OPEN") // OPEN, MATCHED, BOOKED, CANCELLED
  createdAt          DateTime         @default(now())

  bookings        Booking[]
  recommendations ProviderRecommendation[]

  @@map("service_requests")
}

model EmergencyRequest {
  id                 String      @id @default(uuid())
  customerId         String
  customer           User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleType        String      @default("MOTORCYCLE") // MOTORCYCLE, SCOOTER, CAR, OTHER
  problemDescription String?
  latitude           Float
  longitude          Float
  mediaUrl           String?
  aiAnalysisId       String?
  aiAnalysis         AIAnalysis? @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)
  searchRadiusKm     Float       @default(5.0)
  status             String      @default("SEARCHING") // SEARCHING, MATCHED, DISPATCHED, COMPLETED, CANCELLED
  createdAt          DateTime    @default(now())

  bookings        Booking[]
  recommendations ProviderRecommendation[]

  @@map("emergency_requests")
}

model ProviderRecommendation {
  id                 String            @id @default(uuid())
  serviceRequestId   String?
  serviceRequest     ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  emergencyRequestId String?
  emergencyRequest   EmergencyRequest? @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  providerId         String
  provider           ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rank               Int
  totalScore         Float
  isBestMatch        Boolean           @default(false)
  matchReason        String?
  createdAt          DateTime          @default(now())

  @@map("provider_recommendations")
}

model ProviderScore {
  id               String          @id @default(uuid())
  providerId       String
  provider         ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceType      String          @default("SMART_REPAIR") // SMART_REPAIR, PREVENTIVE_MAINTENANCE, EMERGENCY_RESCUE
  skillMatchScore  Float           @default(0)
  distanceScore    Float           @default(0)
  ratingScore      Float           @default(0)
  availabilityScore Float          @default(0)
  priceScore       Float           @default(0)
  experienceScore  Float           @default(0)
  etaScore         Float           @default(0)
  totalScore       Float           @default(0)
  createdAt        DateTime        @default(now())

  @@map("provider_scores")
}

model Booking {
  id                 String            @id @default(uuid())
  customerId         String
  customer           User              @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  providerId         String
  provider           ProviderProfile   @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)
  serviceRequestId   String?
  serviceRequest     ServiceRequest?   @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  emergencyRequestId String?
  emergencyRequest   EmergencyRequest? @relation(fields: [emergencyRequestId], references: [id], onDelete: SetNull)
  serviceType        String            @default("SMART_REPAIR") // SMART_REPAIR, PREVENTIVE_MAINTENANCE, EMERGENCY_RESCUE
  bookingDate        String            // YYYY-MM-DD
  bookingTime        String            // HH:MM
  status             String            @default("PENDING") // PENDING, ACCEPTED, REJECTED, ON_THE_WAY, IN_PROGRESS, COMPLETED, CANCELLED
  totalAmount        Float             @default(0)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  statusHistory BookingStatusHistory[]
  reviews       Review[]

  @@map("bookings")
}

model BookingStatusHistory {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status          String   // PENDING, ACCEPTED, REJECTED, ON_THE_WAY, IN_PROGRESS, COMPLETED, CANCELLED
  changedByUserId String?
  changedByUser   User?    @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  note            String?
  timestamp       DateTime @default(now())

  @@map("booking_status_history")
}

model Review {
  id         String          @id @default(uuid())
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   User            @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation("ProviderReviews", fields: [providerId], references: [id], onDelete: Cascade)
  rating     Int             // 1 to 5 stars
  comment    String?
  createdAt  DateTime        @default(now())

  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // BOOKING, MAINTENANCE, EMERGENCY, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}
